DATABASE_URL=                      # la inyecta Railway
DATA_DIR=/data

# Lista ordenada: el primero es el motor por defecto, los siguientes son el
# desbordamiento cuando el anterior se queda sin cuota.
#   groq         -> sólo Groq. Sin cuota, el trabajo se aparca y se reanuda solo.
#   groq,openai  -> Groq gratis como primario; OpenAI absorbe lo que no quepa.
# Basta con definir la clave de un proveedor para que entre en la cadena.
STT_PROVIDER=groq,openai
GROQ_API_KEY=
OPENAI_API_KEY=

ANTHROPIC_API_KEY=
CLEANUP_MODEL=claude-haiku-4-5
SUMMARY_MODEL=claude-sonnet-5
ENABLE_CLEANUP=true

CHUNK_SECONDS=600                  # 600 con groq, 300 con openai
MAX_UPLOAD_MB=500

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
