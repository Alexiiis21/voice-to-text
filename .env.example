# ─── Base de datos ───────────────────────────────────────────────────────────
# Neon, desde el panel de Vercel. La cadena sirve tal cual como la da Neon, con
# channel_binding y sslmode, y vale tanto la directa como la del pooler: el
# cliente usa `prepare: false`, que es lo que hace falta para convivir con un
# pooler en modo transacción.
DATABASE_URL=postgresql://usuario:clave@ep-xxx.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# ─── Almacenamiento ──────────────────────────────────────────────────────────
# Lo inyecta Vercel al conectar un store de Blob al proyecto. En local hay que
# copiarlo a mano del panel, o `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Scratch temporal. Vacío en Vercel: por defecto usa el tmp del sistema, que es
# lo único escribible. Sólo se define al desplegar en un contenedor con volumen.
DATA_DIR=

# ─── Procesado ───────────────────────────────────────────────────────────────
# Secreto compartido que protege /api/process. Sin él (y sin CRON_SECRET)
# cualquiera puede disparar la cola. Genéralo con: openssl rand -hex 32
PROCESS_SECRET=

# Lo genera Vercel al configurar un cron; protege /api/cron y /api/process.
CRON_SECRET=

# Presupuesto de una invocación de /api/process, en ms. Tiene que quedar por
# debajo del maxDuration de la función (300 s): la diferencia es el margen para
# guardar el trabajo y encadenar la siguiente invocación.
PROCESS_BUDGET_MS=240000

# Sólo hace falta fuera de Vercel. En Vercel se deduce de VERCEL_URL.
APP_URL=

# ─── Transcripción ───────────────────────────────────────────────────────────
# Lista ordenada: el primero es el motor por defecto, los siguientes son el
# desbordamiento cuando el anterior se queda sin cuota.
#   groq         -> sólo Groq. Sin cuota, el trabajo se aparca y se reanuda solo.
#   groq,openai  -> Groq gratis como primario; OpenAI absorbe lo que no quepa.
# Basta con definir la clave de un proveedor para que entre en la cadena.
STT_PROVIDER=groq,openai
GROQ_API_KEY=
OPENAI_API_KEY=

ANTHROPIC_API_KEY=
CLEANUP_MODEL=claude-haiku-4-5
SUMMARY_MODEL=claude-sonnet-5
ENABLE_CLEANUP=true

CHUNK_SECONDS=600                  # 600 con groq, 300 con openai
MAX_UPLOAD_MB=500

# ─── Antibot ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
